{
  "expo": {
    "name": "gymplusone",
    "slug": "gymplusone",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "gymplusone",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
"bundleIdentifier": "com.gymplusone.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocationWhenInUseUsageDescription": "Gym+1 uses your location to show you nearby workouts, events, and people.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Gym+1 uses your location to show you nearby workouts, events, and people."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": ["android.permission.RECORD_AUDIO"],
      "package": "com.gymplusone.gymplusone"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Gym+1 to access your photos to attach images to community posts."
        }
      ],
      "expo-font",
      [
        "@rnmapbox/maps",
        {
          "RNMapboxMapsVersion": "11.8.0"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Gym+1 to use Face ID to log you in."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9632c19a-6dbd-4c75-b34c-6b134cd52a7d"
      },
      "mapboxAccessToken": "pk.eyJ1Ijoib290aXMxNTY5IiwiYSI6ImNtNzIyOTY1djA1aGYybHIzaXE1eG5odTcifQ.Esxl0GXlX91G4919X0bnGg"
    },
    "owner": "devtoby"
  }
}